{
    "author": "Ninots Framework",
    "description": "String, Array, and Collection utility classes for Bun",
    "devDependencies": {
        "@types/bun": "^1.3.13"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./arr": {
            "types": "./dist/src/arr.d.ts",
            "import": "./src/arr.ts",
            "default": "./src/arr.ts"
        },
        "./collection": {
            "types": "./dist/src/collection.d.ts",
            "import": "./src/collection.ts",
            "default": "./src/collection.ts"
        },
        "./str": {
            "types": "./dist/src/str/str.d.ts",
            "import": "./src/str/str.ts",
            "default": "./src/str/str.ts"
        }
    },
    "files": [
        "LICENSE",
        "README.md",
        "dist",
        "dist/src/arr.d.ts",
        "dist/src/collection.d.ts",
        "dist/src/index.d.ts",
        "dist/src/str/str.d.ts",
        "index.ts",
        "jsr.json",
        "src",
        "src/arr.ts",
        "src/collection.ts",
        "src/index.ts",
        "src/str/str.ts"
    ],
    "keywords": [
        "bun",
        "strings",
        "arrays",
        "collections",
        "helpers",
        "utilities",
        "typescript"
    ],
    "license": "MIT",
    "name": "@ninots/support",
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "version": "0.0.1",
    "types": "./dist/src/index.d.ts",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nino-ts/support.git"
    },
    "bugs": {
        "url": "https://github.com/nino-ts/support/issues"
    },
    "homepage": "https://github.com/nino-ts/support#readme"
}
